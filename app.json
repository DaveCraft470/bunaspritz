{
  "expo": {
    "name": "Buna, Spritz?",
    "slug": "spritz",
    "version": "1.0.1",
    "scheme": "bunaspritz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bunacf.spritz",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1FD460",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1FD460",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#1FD460"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spritz folosește locația ta ca să centreze harta pe poziția curentă."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1FD460"
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Spritz folosește microfonul ca să poți trimite mesaje vocale.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spritz folosește pozele tale ca să poți trimite fotografii în mesaje.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93bdbdc8-f486-44d4-88dd-ae519b865a82"
      }
    },
    "owner": "bunacf",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93bdbdc8-f486-44d4-88dd-ae519b865a82"
    }
  }
}
